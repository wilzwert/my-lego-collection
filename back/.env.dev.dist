# DO NOT edit this file directly
# Instead, copy this file to .env.dev to configure dev environment
# This file is prodived as an exemple
# Some values MUST be set, such as  APP_SECRET and REBRICKABLE_API_KEY ;
# For other values, defaults should be sufficient

# define your env variables for the dev env here
APP_ENV=dev
APP_DEBUG=1

###> symfony/framework-bundle ###
# Mandatory, unless already set in .env
# APP_SECRET=
###< symfony/framework-bundle ###

APP_URL=http://localhost:8080
PUBLIC_UPLOAD_BASE_URL=http://localhost:8080/uploads

# DSN to your postgresql database ;
# Do not edit this line if you're using Docker the provided /docker/dev/docker-compose.yaml as is
DATABASE_URL="postgresql://my-lego-collection:!ChangeThisAwesomeSecret!@my-lego-collection-db:5432/my-lego-collection?serverVersion=16&charset=utf8"

# DSN to your redis server ;
# Do not edit this line if you're using Docker the provided /docker/dev/docker-compose.yaml as is
REDIS_URL=redis://mylego-collection-redis

MESSENGER_TRANSPORT_DSN=amqp://my-lego-collection:!ChangeThisAwesomeSecret!@my-lego-collection-db:ampq/%2f/messages

###> Rebrickable API Key ###
# Mandatory
# REBRICKABLE_API_KEY=
###< Rebrickable API Key ###

###> JWT ###
# Mandatory
# JWT_SECRET_KEY=
###< JWT ###

###> symfony/mailer ###
# Mandatory
# MAILER_DSN=smtp://my-lego-collection-mail:1025
###< symfony/mailer ###

# Mandatory for frontend url generation
# FRONTEND_APP_URL="http://localhost:8080"
