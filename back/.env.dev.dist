# DO NOT edit this file directly
# Instead, copy this file to .env.dev to configure dev environment
# This file is prodived as an exemple
# Some values MUST be set, such as  APP_SECRET and REBRICKABLE_API_KEY ;
# For other values, defaults should be sufficient

# define your env variables for the dev env here
APP_ENV=dev
APP_DEBUG=1

###> symfony/framework-bundle ###
# Mandatory, unless already set in .env
# APP_SECRET=
###< symfony/framework-bundle ###

APP_URL=http://localhost:8080

# DSN to your postgresql database ;
# Do not edit this line if you're using Docker the provided /docker/dev/docker-compose.yaml as is
DATABASE_URL="postgresql://mylego_collection:mylego_collection_pass@mylego_collection_db:5432/mylego_collection?serverVersion=16&charset=utf8"

# DSN to your redis server ;
# Do not edit this line if you're using Docker the provided /docker/dev/docker-compose.yaml as is
REDIS_URL=redis://localhost

###> Rebrickable API Key ###
# Mandatory, unless already set in .env ;
# REBRICKABLE_API_KEY=
###< Rebrickable API Key ###

###> JWT ###
# Mandatory, unless already set in .env ;
# JWT_SECRET_KEY=
###< JWT ###
