# DO NOT edit this file directly
# Instead, copy this file to .env.dev to configure test environment
# This file is prodived as an exemple
# Some values MUST be set, such as  APP_SECRET and REBRICKABLE_API_KEY ;
# For other values, defaults should be sufficient

# define your env variables for the test env here
APP_ENV=test
KERNEL_CLASS='App\Kernel'

###> Rebrickable API Key ###
# Mandatory, unless already set in .env ;
# REBRICKABLE_API_KEY=
###< Rebrickable API Key ###

###> JWT ###
# Mandatory, unless already set in .env ;
# JWT_SECRET_KEY=
###< JWT ###

